# Copy this file to .env and fill in your real values.
# Get these from your Supabase project: Settings > API Keys > Publishable and secret API keys tab

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key-here

# Get this from PostHog: Project Settings > Project API Key
VITE_POSTHOG_KEY=phc_your-real-key-here
VITE_POSTHOG_HOST=https://us.i.posthog.com
