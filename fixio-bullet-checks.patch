+const lcFirst = (s: string) => (/^[A-Z][a-z]/.test(s) ? s[0].toLowerCase() + s.slice(1) : s)
+const CONDITIONAL = /\b(if you|if it|once you|when you|where you|where this|in case you)\b/i
